{
  "services": {
    "frontend": {
      "root": "./",
      "framework": "vite"
    },
    "backend": {
      "root": "server/",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}